{
    "name": "nhanaz/libbedrock",
    "type": "library",
    "description": "Common features for Axolotl-PM plugins",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "axolotl-pm/pocketmine-mp": "^5.47.0",
        "thebigcrafter/hydrogen": "^1.1.3",
        "sof3/await-generator": "dev-devtools-shading-compat as 3.6.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "NhanAZ\\libBedrock\\": "src/NhanAZ/libBedrock/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/NhanAZ-Libraries/await-generator",
            "no-api": true
        }
    ],
    "extra": {
        "virion": {
            "spec": "3.0",
            "namespace-root": "NhanAZ\\libBedrock"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "analyse": "./vendor/bin/phpstan analyse -c phpstan.neon.dist",
        "fix-cs": "./vendor/bin/php-cs-fixer fix"
    }
}
